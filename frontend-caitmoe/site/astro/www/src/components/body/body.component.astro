---
import "../../assets/css/util.css"

import CoolText from "../other/coolText.component.astro";
import About from "./about.component.astro";
import Time from "./time.component.vue";
import Weather from "./weather.component.vue";
import Lastfm from "./lastfm.component.vue";
---

<header>
	<main>
		<h1>Hii <CoolText>everypony</CoolText><div class="noWhiteSpace">!</div></h1>
		<About />
		<div class="info">
			<Time client:load/>
			<Weather client:load/>
		</div>
		<Lastfm client:load/>
		<h1>⚠ Website under construction, for the old one go to <a href="https://index.cait.moe">index.cait.moe</a></h1>
	</main>
</header>

<style>
	a:active {
		font-size: 100%;
		line-height: 1rem;
	}
	main {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.info {
		display: flex;
		gap: 1rem;
		justify-content: space-around;
	}
</style>
